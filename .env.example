# Copia este archivo a .env y rellena los valores

# Canal Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=token_que_te_dio_BotFather

# Canal WhatsApp Cloud API (solo si activas WhatsApp)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_PHONE=

# Upstash Redis (perfil por chat_id) - free tier. Si lo dejas vacío, usa memoria local.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# LLM Router: se recorre en orden y cae al siguiente si falla. Deja vacías todas y usa el fallback local.
# GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free tier generoso)
# GEMINI_MODEL=          # opcional: nombre exacto (ej. gemini-flash-lite-latest). Vacío = probar candidatos.
# GROQ_API_KEY=          # https://console.groq.com/keys (free tier)
# DEEPSEEK_API_KEY=      # https://platform.deepseek.com/ (económico)

# Amadeus = vuelos reales (free tier de test). Si vacío, el bot usa un motor simulado de demo.
# AMADEUS_API_KEY=
# AMADEUS_API_SECRET=