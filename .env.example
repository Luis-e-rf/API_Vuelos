# Copia este archivo a .env y rellena los valores

# Canal Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=token_que_te_dio_BotFather

# Canal WhatsApp Cloud API (solo si activas WhatsApp)
# Guía paso a paso en README.md -> "Canal WhatsApp"
# WHATSAPP_TOKEN=            # token permanente de tu app en Meta Developers
# WHATSAPP_PHONE_NUMBER_ID=  # ID del número de negocio que responde
# WHATSAPP_BUSINESS_PHONE=   # tu número de prueba que recibe los mensajes
# WHATSAPP_VERIFY_TOKEN=vuelos-demo-2026  # lo pones también en Meta al registrar el webhook

# Upstash Redis (perfil por chat_id) - free tier. Si lo dejas vacío, usa memoria local.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# LLM: NLU usa Gemini en modo JSON (único proveedor del extractor). El router
# (solo chitchat) recorre Gemini -> Groq -> DeepSeek y cae a plantillas locales si todas están vacías.
# GEMINI_API_KEY=        # https://aistudio.google.com/apikey (free tier) <- la importante
# GEMINI_MODEL=          # opcional. Vacío = gemini-flash-lite-latest
# GROQ_API_KEY=          # https://console.groq.com/keys (free tier: openai/gpt-oss-20b)
# DEEPSEEK_API_KEY=      # https://platform.deepseek.com/ (económico)

# Vuelos: datos en vivo de Google Flights (fast-flights, 100% gratis). Vacío/"1" = activo.
# Si Google bloquea o falla la red, el bot cae a un simulador interno de precios.
# FAST_FLIGHTS_ENABLED=1