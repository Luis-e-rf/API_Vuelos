# Copia este archivo a .env y rellena los valores

# Canal Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=token_que_te_dio_BotFather

# Canal WhatsApp Cloud API (solo si activas WhatsApp)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_PHONE=

# Upstash Redis (perfil por chat_id) - free tier. Si lo dejas vacío, usa memoria local.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=